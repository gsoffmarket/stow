{
  "name": "@stow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch --env-file-if-exists=../../.env.local src/main.ts",
    "migrate": "node --env-file-if-exists=../../.env.local src/db/migrate.ts",
    "setup:local": "node src/local.ts setup",
    "order:local": "node src/local.ts order"
  },
  "dependencies": {
    "@stow/order-engine": "workspace:*",
    "@stow/telegram": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
