# Copy to .env.local and fill in. .env.local is git-ignored; never commit secrets.

APP_ENV=local
PORT=8787

# Local Postgres from compose.yaml (`docker compose up -d`).
DATABASE_URL=postgres://stow:stow@localhost:54329/stow

# 32+ random characters, e.g. `openssl rand -base64 48`.
TASK_TOKEN_SECRET=

# Origins allowed to call the API from a browser, comma-separated.
# The glasses dev server runs on port 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# From @BotFather. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
