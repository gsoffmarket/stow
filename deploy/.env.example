# Copy to deploy/.env on the server. Never commit it.

# The hostname pointing at this server, e.g. stow.example.com, or
# 203-0-113-7.sslip.io if you have no domain (replace with the server's IP).
STOW_HOST=

# A long random password, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# 32+ random characters, e.g. `openssl rand -base64 48`.
TASK_TOKEN_SECRET=

# From @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
